# Google OAuth client (type: "Web application") from console.cloud.google.com.
# Enable the Google Drive API on the project, then add this exact redirect URI:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of the app — used to build the OAuth redirect URI.
APP_URL=http://localhost:3000

# Optional: absolute paths, if yt-dlp / ffmpeg are not on PATH.
# YT_DLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg

# Optional: where tokens, history and scratch files live (default ~/.clipdrive).
# CLIPDRIVE_DATA_DIR=

# Optional: borrow cookies from a signed-in browser when YouTube demands a
# "confirm you're not a bot" check. Values: chrome, chromium, firefox, edge,
# brave, opera… — it must be a browser that is actually installed and signed in
# on the machine running the app. Snap/Flatpak browsers on Linux keep their
# profile elsewhere; pass it explicitly, e.g. chromium:~/snap/chromium/common/chromium
# If the browser can't be read, the app logs a warning and carries on without cookies.
# YT_DLP_COOKIES_FROM_BROWSER=chrome

# Optional: or an exported Netscape-format cookies.txt (wins over the above).
# YT_DLP_COOKIES_FILE=/path/to/cookies.txt

# Optional: force a specific yt-dlp extractor option and disable the automatic
# player-client fallback. E.g. youtube:player_client=tv
# YT_DLP_EXTRACTOR_ARGS=
